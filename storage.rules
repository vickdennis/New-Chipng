rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /blog-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /backgrounds/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /link-icons/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
