rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Blog images: Publicly readable, only owner can upload/delete
    match /blog-images/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidImage();
      allow update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Profile images: Publicly readable, only owner can upload/delete
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidImage();
      allow update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Background images: Publicly readable, only owner can upload/delete
    match /backgrounds/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidImage();
      allow update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Link icons: Publicly readable, only owner can upload/delete
    match /link-icons/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidImage();
      allow update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }
  }
}
