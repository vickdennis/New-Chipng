rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // PILLAR 0: THE MASTER DENY & GLOBAL HELPERS
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ---------------------------------------------------------
    // PILLAR 2: VALIDATION BLUEPRINTS
    // ---------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'displayName', 'createdAt', 'updatedAt', 'isDeleted']) &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.isDeleted is bool;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['email', 'updatedAt']) &&
             data.email is string && data.email.size() <= 100 &&
             data.get('phone', '') is string && data.get('phone', '').size() <= 50 &&
             data.get('address', '') is string && data.get('address', '').size() <= 500;
    }

    function isValidLink(data) {
      return data.keys().hasAll(['userId', 'title', 'url', 'createdAt', 'updatedAt', 'isDeleted']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 100 &&
             data.url is string && data.url.size() <= 2000 &&
             data.isDeleted is bool &&
             data.get('thumbnail', '') is string;
    }

    function isValidBlog(data) {
      return data.keys().hasAll(['userId', 'title', 'slug', 'content', 'createdAt', 'updatedAt', 'isDeleted']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.slug is string && data.slug.size() <= 300 &&
             data.content is string && data.content.size() <= 100000 &&
             data.isDeleted is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['userId', 'name', 'price', 'createdAt', 'updatedAt', 'isDeleted']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.isDeleted is bool;
    }

    function isValidShout(data) {
      return data.keys().hasAll(['userId', 'content', 'createdAt', 'updatedAt', 'isDeleted']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.content is string && data.content.size() <= 1000 &&
             data.isDeleted is bool;
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['userId', 'url', 'type', 'createdAt', 'updatedAt', 'isDeleted']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.url is string && data.url.size() <= 2000 &&
             data.type in ['image', 'video'] &&
             data.isDeleted is bool;
    }

    function isValidBackup(data) {
      return data.keys().hasAll(['originalId', 'collectionName', 'data', 'action', 'performedBy', 'timestamp']) &&
             data.originalId is string && data.collectionName is string &&
             data.action in ['create', 'update', 'delete', 'rollback'] &&
             data.performedBy is string && data.timestamp is timestamp;
    }

    // ---------------------------------------------------------
    // PILLAR 4 & 8: COLLECTION MATCH BLOCKS & SECURE LISTS
    // ---------------------------------------------------------

    match /users/{userId} {
      // Public profile data
      allow get: if isValidId(userId);
      allow list: if (request.query.limit <= 10 && resource.data.isDeleted == false) || isAdmin();
      
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming()) && (
        !incoming().keys().hasAny(['role', 'isPremium', 'plan', 'isVerified', 'status', 'earnings', 'email', 'phone', 'address', 'contactEmail'])
      );
      
      allow update: if (isOwner(userId) || isAdmin()) && (
        (isOwner(userId) && isEmailVerified() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'photoURL', 'coverImage', 'socialLinks', 'theme', 'brandColor', 'iconStyle', 'backgroundType', 'backgroundColor', 'backgroundImage', 'textColor', 'buttonStyle', 'font', 'updatedAt', 'isDeleted', 'onboardingCompleted'])) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'isPremium', 'plan', 'isVerified', 'status', 'updatedAt', 'isDeleted', 'displayName', 'bio', 'photoURL', 'coverImage', 'socialLinks', 'premiumUntil', 'onboardingCompleted']))
      );

      // Private settings/PII
      match /private/info {
        allow get: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidPrivateInfo(incoming());
      }
    }

    match /users_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /links/{linkId} {
      allow get: if isValidId(linkId);
      allow list: if (resource.data.active == true && resource.data.isDeleted == false) || (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isEmailVerified() && isValidId(linkId) && isValidLink(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isOwner(existing().userId) || isAdmin()) && (isAdmin() || isEmailVerified()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'icon', 'active', 'position', 'isDeleted', 'deletedAt', 'updatedAt', 'type', 'scheduledStart', 'scheduledEnd', 'styles', 'thumbnail'])
      );
      allow delete: if (isOwner(existing().userId) || isAdmin()) && (isAdmin() || isEmailVerified());
    }

    match /links_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /shouts/{shoutId} {
      allow get: if isValidId(shoutId);
      allow list: if (resource.data.isDeleted == false) || isAdmin();
      allow create: if isSignedIn() && isEmailVerified() && isValidId(shoutId) && isValidShout(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if (isOwner(existing().userId) || isAdmin()) && (isAdmin() || isEmailVerified());
    }

    match /shouts_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if (resource.data.isDeleted == false) || isAdmin();
      allow create: if isSignedIn() && isEmailVerified() && isValidId(mediaId) && isValidMedia(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if (isOwner(existing().userId) || isAdmin()) && (isAdmin() || isEmailVerified());
    }

    match /media_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /blogs/{blogId} {
      allow get: if isValidId(blogId);
      allow list: if (resource.data.published == true && resource.data.isDeleted == false) || (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isEmailVerified() && isValidId(blogId) && isValidBlog(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isOwner(existing().userId) || isAdmin()) && (isAdmin() || isEmailVerified()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'slug', 'content', 'excerpt', 'coverImage', 'published', 'tags', 'updatedAt', 'isDeleted', 'seoTitle', 'seoDescription', 'seoKeywords'])
      );
      allow delete: if (isOwner(existing().userId) || isAdmin()) && (isAdmin() || isEmailVerified());
    }

    match /blogs_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if resource.data.active == true || (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isOwner(existing().userId) || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'image', 'category', 'stock', 'active', 'updatedAt', 'isDeleted'])
      );
      allow delete: if (isOwner(existing().userId) || isAdmin());
    }

    match /products_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false; // Only server writes
      allow update: if false;
      allow delete: if false;
    }

    match /orders/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false; // Only server writes
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
