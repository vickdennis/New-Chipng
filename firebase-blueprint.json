{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user information and settings.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "suspended"] }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public profile configuration for the link-in-bio page.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string" },
        "theme": { "type": "string", "enum": ["minimal", "neon", "glassmorphism", "dark", "sunset"] },
        "buttonStyle": { "type": "string", "enum": ["rounded", "pill", "square"] },
        "backgroundType": { "type": "string", "enum": ["solid", "gradient"] },
        "backgroundColor": { "type": "string" },
        "totalClicks": { "type": "number" }
      },
      "required": ["userId", "username", "theme", "buttonStyle"]
    },
    "Link": {
      "title": "Link",
      "description": "A link displayed on the user's public profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "icon": { "type": "string" },
        "active": { "type": "boolean" },
        "position": { "type": "number" },
        "clicks": { "type": "number" }
      },
      "required": ["userId", "title", "url", "active", "position"]
    },
    "UsernameMap": {
      "title": "Username Map",
      "description": "Maps a unique username to a userId for routing.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user data."
    },
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Public profile settings."
    },
    "/profiles_by_username/{username}": {
      "schema": "UsernameMap",
      "description": "Username to userId lookup."
    },
    "/links/{linkId}": {
      "schema": "Link",
      "description": "User links."
    }
  }
}
