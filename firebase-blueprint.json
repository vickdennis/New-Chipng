{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Core user profile data including plan and customization settings.",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "Unique username for public profile URL." },
        "displayName": { "type": "string", "description": "User's public name." },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "plan": { "type": "string", "enum": ["basic", "pro", "business"] },
        "isPremium": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "theme": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["username", "email"]
    },
    "Link": {
      "title": "Profile Link",
      "description": "A link displayed on the user's public profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string" },
        "active": { "type": "boolean" },
        "position": { "type": "number" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["userId", "title", "url"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "A blog post created by users or administrators.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "authorId": { "type": "string" },
        "published": { "type": "boolean" },
        "tags": { "type": "array" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["userId", "title", "slug", "content"]
    },
    "Backup": {
      "title": "Data Backup",
      "description": "A snapshot of a document before mutation.",
      "type": "object",
      "properties": {
        "originalId": { "type": "string" },
        "collectionName": { "type": "string" },
        "data": { "type": "object" },
        "action": { "type": "string", "enum": ["create", "update", "delete", "rollback"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "performedBy": { "type": "string" }
      },
      "required": ["originalId", "collectionName", "data", "action", "performedBy"]
    },
    "Shout": {
      "title": "Public Shout",
      "description": "Short social update from a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isDeleted": { "type": "boolean" }
      }
    },
    "Media": {
      "title": "Media Post",
      "description": "An image or video post from a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isDeleted": { "type": "boolean" }
      }
    },
    "Product": {
      "title": "Store Product",
      "description": "Product sold in the platform store by users or admins.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "active": { "type": "boolean" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["userId", "name", "price"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Record of a payment or purchase.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "reference": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection."
    },
    "/users_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for user profiles."
    },
    "/links/{linkId}": {
      "schema": "Link",
      "description": "User profile links."
    },
    "/links_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for user links."
    },
    "/blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "Platform blog posts."
    },
    "/blogs_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for blog posts."
    },
    "/shouts/{shoutId}": {
      "schema": "Shout",
      "description": "User highlights/shouts."
    },
    "/shouts_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for shouts."
    },
    "/media/{mediaId}": {
      "schema": "Media",
      "description": "User media collection."
    },
    "/media_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for media."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Marketplace products."
    },
    "/products_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for products."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Collection of payments."
    }
  }
}
