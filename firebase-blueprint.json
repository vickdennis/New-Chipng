{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Core user profile data including plan and customization settings.",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "Unique username for public profile URL." },
        "displayName": { "type": "string", "description": "User's public name." },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "plan": { "type": "string", "enum": ["basic", "pro", "business"] },
        "isPremium": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "theme": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["username", "email"]
    },
    "Link": {
      "title": "Profile Link",
      "description": "A link displayed on the user's public profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string" },
        "active": { "type": "boolean" },
        "position": { "type": "number" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["userId", "title", "url"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "A blog post created by administrators.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "authorId": { "type": "string" },
        "published": { "type": "boolean" },
        "tags": { "type": "array" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["title", "slug", "content"]
    },
    "Backup": {
      "title": "Data Backup",
      "description": "A snapshot of a document before mutation.",
      "type": "object",
      "properties": {
        "originalId": { "type": "string" },
        "collectionName": { "type": "string" },
        "data": { "type": "object" },
        "action": { "type": "string", "enum": ["create", "update", "delete", "rollback"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "performedBy": { "type": "string" }
      },
      "required": ["originalId", "collectionName", "data", "action", "performedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection."
    },
    "/users_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for user profiles."
    },
    "/links/{linkId}": {
      "schema": "Link",
      "description": "User profile links."
    },
    "/links_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for user links."
    },
    "/blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "Platform blog posts."
    },
    "/blogs_backup/{backupId}": {
      "schema": "Backup",
      "description": "Backups for blog posts."
    }
  }
}
