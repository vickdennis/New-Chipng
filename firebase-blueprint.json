{
  "entities": {
    "User": {
      "title": "User",
      "description": "User information and profile settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "isPremium": { "type": "boolean" },
        "premiumUntil": { "type": "string", "format": "date-time" },
        "theme": { "type": "string", "enum": ["minimal", "neon", "glassmorphism", "dark", "sunset"] },
        "buttonStyle": { "type": "string", "enum": ["rounded", "pill", "square"] },
        "backgroundType": { "type": "string", "enum": ["solid", "gradient", "image"] },
        "backgroundColor": { "type": "string" },
        "backgroundImage": { "type": "string" },
        "totalClicks": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "plan": { "type": "string", "enum": ["basic", "pro", "business"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "inactive"] },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "appointmentsEnabled": { "type": "boolean" },
        "appointments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "dateTime": { "type": "string", "format": "date-time" },
              "contactLink": { "type": "string" }
            }
          }
        },
        "socialLinks": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "twitter": { "type": "string" },
            "linkedin": { "type": "string" },
            "youtube": { "type": "string" },
            "facebook": { "type": "string" },
            "whatsapp": { "type": "string" },
            "tiktok": { "type": "string" }
          }
        }
      },
      "required": ["email", "role", "createdAt", "username", "theme", "buttonStyle", "backgroundType", "plan", "subscriptionStatus"]
    },
    "Link": {
      "title": "Link",
      "description": "A link displayed on the user's public profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "icon": { "type": "string" },
        "active": { "type": "boolean" },
        "position": { "type": "number" },
        "clicks": { "type": "number" },
        "scheduledStart": { "type": "string", "format": "date-time" },
        "scheduledEnd": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["standard", "youtube", "tiktok"] }
      },
      "required": ["userId", "title", "url", "active", "position"]
    },
    "Analytics": {
      "title": "Analytics",
      "description": "Time-series click data for links and profiles.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "linkId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "date": { "type": "string" }
      },
      "required": ["userId", "timestamp", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User and profile data."
    },
    "/links/{linkId}": {
      "schema": "Link",
      "description": "User links."
    },
    "/analytics/{analyticsId}": {
      "schema": "Analytics",
      "description": "Analytics events."
    }
  }
}
