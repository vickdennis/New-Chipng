rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // PILLAR 0: THE MASTER DENY & GLOBAL HELPERS
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ---------------------------------------------------------
    // PILLAR 2: VALIDATION BLUEPRINTS
    // ---------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email']) &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.email is string && data.email.size() <= 100 &&
             data.get('displayName', '') is string && data.get('displayName', '').size() <= 100 &&
             data.get('isDeleted', false) is bool;
    }

    function isValidLink(data) {
      return data.keys().hasAll(['userId', 'title', 'url']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 100 &&
             data.url is string && data.url.size() <= 2000;
    }

    function isValidBackup(data) {
      return data.keys().hasAll(['originalId', 'collectionName', 'data', 'action', 'performedBy']) &&
             data.originalId is string && data.collectionName is string &&
             data.action in ['create', 'update', 'delete', 'rollback'] &&
             data.performedBy == request.auth.uid;
    }

    // ---------------------------------------------------------
    // PILLAR 4 & 8: COLLECTION MATCH BLOCKS & SECURE LISTS
    // ---------------------------------------------------------

    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin(); // Only admins can list all users
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        !incoming().keys().hasAny(['role', 'isPremium', 'plan', 'isVerified', 'status'])
      );
      allow update: if (isOwner(userId) || isAdmin()) && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'photoURL', 'coverImage', 'socialLinks', 'theme', 'backgroundType', 'backgroundColor', 'backgroundImage', 'textColor', 'buttonStyle', 'updatedAt', 'isDeleted', 'phone', 'address', 'contactEmail'])) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'isPremium', 'plan', 'isVerified', 'status', 'updatedAt', 'isDeleted', 'displayName', 'bio', 'photoURL', 'coverImage', 'socialLinks', 'phone', 'address', 'contactEmail']))
      );
    }

    match /users_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /links/{linkId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidLink(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isOwner(existing().userId) || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'icon', 'active', 'position', 'isDeleted', 'deletedAt', 'updatedAt'])
      );
    }

    match /links_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs_backup/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidBackup(incoming());
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products_backup/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidBackup(incoming());
    }

    match /shouts/{shoutId} {
      allow read: if true;
      allow create: if isSignedIn() && (isOwner(incoming().userId) || isAdmin());
      allow update: if (isOwner(existing().userId) || isAdmin());
      allow delete: if (isOwner(existing().userId) || isAdmin());
    }

    match /shouts_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create: if isSignedIn() && (isOwner(incoming().userId) || isAdmin());
      allow update: if (isOwner(existing().userId) || isAdmin());
      allow delete: if (isOwner(existing().userId) || isAdmin());
    }

    match /media_backup/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidBackup(incoming());
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
